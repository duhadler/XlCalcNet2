<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="CXSC" />
		<Option pch_mode="2" />
		<Option compiler="null" />
		<Build>
			<Target title="LibWin64_CXSC">
				<Option output="../../../local/xlcalcnet2/lib/CXSC" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="../../../local/xlcalcnet2/obj/libCXSC" />
				<Option type="2" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-march=k8" />
					<Add option="-O3" />
					<Add option="-Wall" />
					<Add option="-std=gnu++14" />
					<Add option="-m64" />
					<Add option="-Wno-unused-variable" />
					<Add option="-Wno-unused-but-set-variable" />
					<Add option="-DUse_Double" />
					<Add option="-DNDEBUG" />
					<Add directory="../C-XSC-MPFR-MPFI" />
					<Add directory="../../../local/xlcalcnet2/include" />
					<Add directory="../../../local/xlcalcnet2/include/flint" />
					<Add directory="../mpNum/Include" />
					<Add directory="../BoostEigenMath/Include" />
					<Add directory="../../MP64/eigen" />
					<Add directory="../../Boost" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-m64" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++11" />
		</Compiler>
		<Unit filename="CXSC.cpp" />
		<Unit filename="CXSC.h" />
		<Unit filename="mpfcclass.cpp" />
		<Unit filename="mpfcclass.hpp" />
		<Unit filename="mpfciclass.cpp" />
		<Unit filename="mpfciclass.hpp" />
		<Unit filename="mpficlass.cpp" />
		<Unit filename="mpficlass.hpp" />
		<Unit filename="mpfrclass.cpp" />
		<Unit filename="mpfrclass.hpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
