<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ArbPrecNetGCCK8" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="ArbPrecNetGCCK8">
				<Option output="../../../local/xlcalcnet2/bin/ArbPrecNetGCCK8" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="1" extension_auto="1" />
				<Option object_output="../../../local/xlcalcnet2/obj/ArbPrecNetGCCK8" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-march=k8" />
					<Add option="-O3" />
					<Add option="-std=gnu++20" />
					<Add option="-Wno-sign-compare" />
					<Add option="-Wno-deprecated-declarations" />
					<Add option="-Wno-return-local-addr" />
					<Add option="-Wno-maybe-uninitialized" />
					<Add option="-DBUILD_MPNUMC_DLL" />
					<Add option="-DUSE_EIGEN" />
					<Add option="-DNDEBUG" />
					<Add option="-D__MINGW64__" />
					<Add option="-D__STDC_LIMIT_MACROS" />
					<Add option="-DBOOST_MATH_INSTRUMENT2" />
					<Add option="-DMPFULL" />
					<Add directory="Include" />
					<Add directory="../BoostEigenMath/Include" />
					<Add directory="../BoostMath/Include" />
					<Add directory="../../MP64/eigen" />
					<Add directory="../../../local/xlcalcnet2/include" />
					<Add directory="../../../local/xlcalcnet2/include/flint" />
					<Add directory="../../Boost" />
				</Compiler>
				<Linker>
					<Add option="-s -static -lquadmath" />
					<Add library="libBoostMpfr.a" />
					<Add library="libBoostMpfr2.a" />
					<Add library="libEigenDenseMpAny.a" />
					<Add library="libflint.a" />
					<Add library="libmpc.a" />
					<Add library="libmpfr.a" />
					<Add library="libgmp.a" />
					<Add library="libMaps1.a" />
					<Add directory="../../../local/xlcalcnet2/lib" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=gnu++14" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="ConversionsShort.cpp" />
		<Unit filename="Helperfunctions.cpp" />
		<Unit filename="Include/HelperFunctions.h" />
		<Unit filename="Include/mpNumC_Arb.h" />
		<Unit filename="Include/mpNumC_FReal.h" />
		<Unit filename="Include/mpNumC_Main.h" />
		<Unit filename="Include/mpNumC_Mpfr.h" />
		<Unit filename="Include/mpNumC_OReal.h" />
		<Unit filename="Include/mpNumC_QReal.h" />
		<Unit filename="Include/mpNumC_SReal.h" />
		<Unit filename="Include/mpNumC_Scalar.h" />
		<Unit filename="Include/mpNumC_XReal.h" />
		<Unit filename="UseAnyEigenMat.cpp" />
		<Unit filename="UseArb.cpp" />
		<Unit filename="UseFReal.cpp" />
		<Unit filename="UseMpfr.cpp" />
		<Unit filename="UseOReal.cpp" />
		<Unit filename="UseQReal.cpp" />
		<Unit filename="UseSReal.cpp" />
		<Unit filename="UseXReal.cpp" />
		<Unit filename="mpAny.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
